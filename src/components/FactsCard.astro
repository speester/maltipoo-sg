---
// Side-slot filler for CaptionedBlock without an image: quick-facts checklist card.
// Design: mint header cap + wagging paw so the side panel reads designed, not plain.
interface Props {
  heading: string;
  items: string[];
}
const { heading, items } = Astro.props;
---

<div class="pop overflow-hidden">
  <div class="bg-mint px-6 py-4 md:px-8 flex items-center gap-3">
    <span class="inline-flex w-9 h-9 rounded-full bg-surface shadow-[var(--shadow-pop-sm)] items-center justify-center shrink-0" aria-hidden="true">
      <svg class="w-4.5 h-4.5 text-mint-ink wag" viewBox="0 0 24 24" fill="currentColor">
        <ellipse cx="12" cy="15.5" rx="5" ry="4.2" />
        <ellipse cx="5.4" cy="10.5" rx="2" ry="2.6" />
        <ellipse cx="9.8" cy="7.4" rx="2" ry="2.7" />
        <ellipse cx="14.2" cy="7.4" rx="2" ry="2.7" />
        <ellipse cx="18.6" cy="10.5" rx="2" ry="2.6" />
      </svg>
    </span>
    <h3 class="text-lg m-0 text-mint-ink">{heading}</h3>
  </div>
  <ul class="list-none p-6 md:p-8 m-0 space-y-3">
    {items.map((item) => (
      <li class="flex gap-3 items-start text-sm text-ink-soft">
        <svg class="w-5 h-5 shrink-0 text-mint-ink mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10" fill="#DFF3E8" stroke="none" />
          <path d="m8.5 12.5 2.5 2.5 5-6" />
        </svg>
        <span>{item}</span>
      </li>
    ))}
  </ul>
</div>
