---
// Side-slot filler for CaptionedBlock without an image: quick-facts checklist card.
interface Props {
  heading: string;
  items: string[];
}
const { heading, items } = Astro.props;
---

<div class="pop p-6 md:p-8">
  <h3 class="text-lg mb-4">{heading}</h3>
  <ul class="list-none p-0 m-0 space-y-3">
    {items.map((item) => (
      <li class="flex gap-3 items-start text-sm text-ink-soft">
        <svg class="w-5 h-5 shrink-0 text-mint-ink mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10" fill="#DFF3E8" stroke="none" />
          <path d="m8.5 12.5 2.5 2.5 5-6" />
        </svg>
        <span>{item}</span>
      </li>
    ))}
  </ul>
</div>
