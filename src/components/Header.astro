---
import { site, whatsappLink } from '../data/site';

// HDB guide moved off the header into the blog index guide strip (owner request 2026-07-24).
const nav = [
  { label: 'Puppies', href: '/puppies' },
  { label: 'Breed Guide', href: '/what-is-a-maltipoo' },
  { label: 'Price Guide', href: '/maltipoo-price-singapore' },
  { label: 'Size', href: '/maltipoo-size' },
  { label: 'Compare Breeds', href: '/compare-maltipoo' },
  { label: 'Blog', href: '/blog' },
];
---

<header class="sticky top-0 pt-3 pb-2" style="z-index: var(--z-sticky); background: var(--color-base);">
  <div class="container-site">
    <div class="pop !rounded-full flex items-center justify-between gap-4 pl-5 pr-3 py-2.5" style="box-shadow: 0 4px 0 var(--color-tint-300);">
      <a href="/" class="flex items-center gap-2 no-underline shrink-0" aria-label={`${site.brand} home`}>
        <span class="w-9 h-9 rounded-full bg-primary flex items-center justify-center shrink-0">
          <svg class="w-5 h-5 text-white" viewBox="0 0 32 32" fill="currentColor" aria-hidden="true">
            <circle cx="16" cy="19" r="9" /><circle cx="8" cy="11" r="3.4" /><circle cx="16" cy="8.5" r="3.4" /><circle cx="24" cy="11" r="3.4" />
          </svg>
        </span>
        <span class="font-bold text-lg" style="font-family: var(--font-display);">Maltipoo<span class="text-primary">.sg</span></span>
      </a>

      <nav class="hidden lg:flex items-center gap-1" aria-label="Main">
        {nav.map((item) => (
          <a href={item.href} class="font-semibold text-sm text-ink-soft hover:text-primary hover:bg-tint-200 rounded-full px-4 py-2 no-underline transition-colors">{item.label}</a>
        ))}
      </nav>

      <div class="flex items-center gap-2 shrink-0">
        <a href={whatsappLink('Hi! I would like to ask about Maltipoo puppies.')} class="btn-cta hidden sm:inline-flex text-sm !py-2 !px-5">
          WhatsApp us
        </a>
        <button
          id="menu-toggle"
          class="lg:hidden w-11 h-11 flex items-center justify-center rounded-full bg-tint-200 cursor-pointer"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Open menu"
        >
          <svg class="w-6 h-6 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16" />
          </svg>
        </button>
      </div>
    </div>

    <div id="mobile-menu" class="hidden lg:hidden pt-2" data-state="closed">
      <nav class="pop p-3 flex flex-col gap-1" aria-label="Mobile">
        {nav.map((item) => (
          <a href={item.href} class="font-semibold text-ink no-underline rounded-2xl px-4 py-3 hover:bg-tint-200">{item.label}</a>
        ))}
        <a href={whatsappLink('Hi! I would like to ask about Maltipoo puppies.')} class="btn-cta mt-1 text-sm">WhatsApp us</a>
      </nav>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  });
</script>
