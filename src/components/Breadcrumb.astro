---
interface Props {
  items: { name: string; url: string }[];
  bare?: boolean;
  class?: string;
}
const { items, bare = false, class: className = '' } = Astro.props;
---

<nav aria-label="Breadcrumb" class:list={[!bare && 'container-site', className]}>
  <ol class="flex flex-wrap items-center gap-1 list-none p-0 m-0 text-sm">
    {items.map((item, i) => (
      <li class="flex items-center gap-1">
        {i > 0 && (
          <svg class="w-3.5 h-3.5 text-ink-soft/60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
            <path d="m9 6 6 6-6 6" />
          </svg>
        )}
        {i === items.length - 1 ? (
          <span class="font-semibold text-primary" aria-current="page">{item.name}</span>
        ) : (
          <a href={item.url} class="text-ink-soft no-underline hover:text-primary hover:underline">{item.name}</a>
        )}
      </li>
    ))}
  </ol>
</nav>
