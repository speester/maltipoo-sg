---
// GA4, wired to protect the perf budget: the gtag library is fetched only after
// the first real interaction (or a 4s idle fallback), never during initial load.
// Conversion events: whatsapp_click and cta_click (the key events marked on the
// GA4 property). Renders nothing until a measurement ID is set in site.ts.
import { site } from '../data/site';
const id = site.ga4MeasurementId;
---
{id && (
  <script is:inline define:vars={{ id }}>
    window.dataLayer = window.dataLayer || [];
    function gtag() { window.dataLayer.push(arguments); }
    window.gtag = gtag;

    let loaded = false;
    // Only the production host reports: localhost, previews and www never pollute GA4.
    const prodHost = location.hostname === 'maltipoo.sg';
    function loadGA() {
      if (loaded || !prodHost) return;
      loaded = true;
      const s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=' + id;
      document.head.appendChild(s);
      gtag('js', new Date());
      gtag('config', id);
    }
    ['pointerdown', 'keydown', 'scroll', 'touchstart'].forEach(function (evt) {
      window.addEventListener(evt, loadGA, { once: true, passive: true });
    });
    setTimeout(loadGA, 4000);

    // Passport card delegate. Mirrors cardEvent() in src/lib/ga4-card.ts; keep the two in step.
    var CARD_EVENTS = ['book_viewing_click', 'whatsapp_click', 'send_click', 'call_click', 'earliest_visit_click', 'date_select', 'time_select', 'photo_dot_click', 'photo_arrow_click', 'photo_tap', 'photo_swipe', 'video_play_click', 'perks_open', 'kit_list_toggle', 'perks_close', 'whatsapp_web_click', 'whatsapp_app_click', 'call_copy_click', 'call_dial_click', 'popup_close', 'maps_click'];
    function cardEvents(el, pupEl) {
      var name = el.getAttribute('data-ga4-event');
      if (CARD_EVENTS.indexOf(name) === -1) return [];
      var pup = {};
      if (pupEl) pup = { puppy_id: pupEl.getAttribute('data-pup'), puppy_name: pupEl.getAttribute('data-pup-name'), breed: pupEl.getAttribute('data-pup-breed') };
      var params = Object.assign({}, pup);
      var label = el.getAttribute('data-ga4-label');
      if (label) params[name === 'book_viewing_click' ? 'viewing' : 'label'] = label;
      var out = [{ name: name, params: params }];
      var a = el.closest('a[href]');
      var href = a ? a.getAttribute('href') || '' : '';
      if (name !== 'whatsapp_click' && href.indexOf('wa.me') !== -1) out.push({ name: 'whatsapp_click', params: Object.assign({ button: name }, pup) });
      return out;
    }

    // Passport card delegate (see src/lib/ga4-card.ts). Runs first; a card hit stops the generic listener below.
    document.addEventListener('click', function (e) {
      const t = e.target;
      if (!t || !t.closest) return;
      const card = t.closest('[data-ga4-event]');
      if (!card || location.hostname !== 'maltipoo.sg') return;
      const evs = cardEvents(card, card.closest('[data-pup]'));
      if (!evs.length) return;
      e.stopImmediatePropagation();
      loadGA();
      evs.forEach(function (ev) { gtag('event', ev.name, ev.params); });
    }, true);
    document.addEventListener('click', function (e) {
      const t = e.target;
      if (!t || !t.closest) return;
      const wa = t.closest('a[href*="wa.me"], a[href*="api.whatsapp.com"]');
      if (wa) {
        loadGA();
        if (prodHost) gtag('event', 'whatsapp_click', { link_url: wa.getAttribute('href') || '' });
        return;
      }
      const cta = t.closest('.btn-cta, .btn-wa, [data-cta]');
      if (cta) {
        loadGA();
        if (prodHost) gtag('event', 'cta_click', { label: (cta.textContent || '').trim().slice(0, 60) });
      }
    }, true);
  </script>
)}
