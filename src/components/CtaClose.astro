---
// Closing CTA with real hierarchy: 2/3 dark primary card + 1/3 stacked lighter
// actions — never two identical ribbons (bug checklist #6).
import { site, whatsappLink } from '../data/site';

interface Props {
  secondaryHeading?: string;
  secondaryText?: string;
  secondaryHref?: string;
  secondaryLabel?: string;
}
const {
  secondaryHeading = 'Still deciding?',
  secondaryText = 'Read the price guide first: every dollar explained, no surprises at the shop.',
  secondaryHref = '/maltipoo-price-singapore',
  secondaryLabel = 'See the price guide',
} = Astro.props;
---

<section class="container-site py-10">
  <div class="grid md:grid-cols-3 gap-5">
    <div class="md:col-span-2 rounded-[var(--radius-panel)] bg-ink text-white p-8 md:p-10">
      <p class="eyebrow !text-cta mb-2">Meet your Maltipoo</p>
      <h2 class="text-2xl md:text-3xl mb-3 text-white">Come say hello at Balestier</h2>
      <p class="text-white/80 max-w-[52ch] mb-6">
        {site.address.full} · {site.hours}. Or message us first: tell us about your home
        and routine, and we'll tell you honestly if a Maltipoo fits.
      </p>
      <div class="flex flex-wrap gap-3">
        <a href={whatsappLink('Hi! I would like to visit and meet the Maltipoos.')} class="btn-cta">WhatsApp {site.phoneDisplay}</a>
      </div>
    </div>
    <div class="flex flex-col gap-5">
      <div class="pop p-6 bg-tint-200 flex-1">
        <h3 class="text-lg mb-2">{secondaryHeading}</h3>
        <p class="text-sm text-ink-soft mb-4">{secondaryText}</p>
        <a href={secondaryHref} class="btn-outline text-sm !py-2">{secondaryLabel}</a>
      </div>
      <a href={site.license.registryUrl} rel="noopener" target="_blank" class="pop pop-hover p-5 no-underline flex items-center gap-3">
        <svg class="w-8 h-8 shrink-0 text-primary" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2 4 5v6c0 5 3.4 9.7 8 11 4.6-1.3 8-6 8-11V5l-8-3Z" /></svg>
        <span class="text-sm font-semibold">Verify licence {site.license.avsNumber} on the AVS registry</span>
        <svg class="w-4 h-4 ml-auto shrink-0 text-ink-soft" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="m9 6 6 6-6 6" /></svg>
      </a>
    </div>
  </div>
</section>
