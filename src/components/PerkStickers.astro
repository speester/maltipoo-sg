---
// Bakery Box "Style I" tilted perk stickers: Free 30-item kit, Vaccinated,
// Microchipped, Vet-checked, with the Curious Tails SVG icons. Larger on phones
// (12.5px text, 19px icons). Shared by BakeryPupCard and the puppy page.
import { PERKS, perkIcon } from '../lib/perk-icons';

interface Props {
  large?: boolean;
}
const { large = false } = Astro.props;
---

<ul class:list={['pk-stk', large && 'lg']} aria-label="Included with every puppy">
  {PERKS.map(([k, label]) => <li><Fragment set:html={perkIcon(k)} />{label}</li>)}
</ul>

<style>
  .pk-stk { display: flex; flex-wrap: wrap; gap: 6px; justify-content: center; padding: 4px 0; margin: 0; list-style: none; font-family: var(--font-body); }
  .pk-stk li {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 10.5px;
    font-weight: 900;
    line-height: 1.3;
    color: var(--color-ink);
    padding: 4px 9px;
    border-radius: 10px;
    border: 2.5px solid #fff;
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.13);
    margin: 0;
  }
  .pk-stk li:nth-child(1) { background: #c8f0dc; transform: rotate(-4deg); }
  .pk-stk li:nth-child(2) { background: #d6e8ff; transform: rotate(3deg); }
  .pk-stk li:nth-child(3) { background: #ffe3a6; transform: rotate(-2deg); }
  .pk-stk li:nth-child(4) { background: #e8dcff; transform: rotate(4deg); }
  .pk-stk :global(.ic) { width: 16px; height: 16px; flex: none; }

  .pk-stk.lg { justify-content: flex-start; gap: 10px; }
  .pk-stk.lg li { font-size: 13.5px; padding: 6px 12px; gap: 6px; }
  .pk-stk.lg :global(.ic) { width: 20px; height: 20px; }

  @media (max-width: 640px) {
    .pk-stk { gap: 7px; }
    .pk-stk li { font-size: 12.5px; padding: 6px 11px; gap: 5px; }
    .pk-stk :global(.ic) { width: 19px; height: 19px; }
  }
</style>
