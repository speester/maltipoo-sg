---
// Seamless one-directional paw-print marquee (premium-design-standard #13):
// the paw row is rendered TWICE back-to-back and translateX animates 0 → -50%
// linearly, so the reset lands exactly where the first copy started — no seam.
// Purely decorative; hidden from AT; freezes under prefers-reduced-motion.
interface Props {
  class?: string;
  tone?: 'primary' | 'cta' | 'white';
}
const { class: className = '', tone = 'primary' } = Astro.props;
const toneClass =
  tone === 'cta' ? 'text-cta' : tone === 'white' ? 'text-white/30' : 'text-primary/25';
const paws = Array.from({ length: 14 });
---

<div class:list={['overflow-hidden select-none', className]} aria-hidden="true">
  <div class="paw-track flex w-max items-center">
    {[0, 1].map(() => (
      <div class:list={['flex items-center gap-8 pr-8', toneClass]}>
        {paws.map((_, i) => (
          <svg
            class="w-5 h-5 shrink-0"
            style={`transform: rotate(${i % 2 ? 12 : -12}deg) translateY(${i % 2 ? '-3px' : '3px'})`}
            viewBox="0 0 24 24"
            fill="currentColor"
          >
            <ellipse cx="12" cy="15.5" rx="5" ry="4.2" />
            <ellipse cx="5.4" cy="10.5" rx="2" ry="2.6" />
            <ellipse cx="9.8" cy="7.4" rx="2" ry="2.7" />
            <ellipse cx="14.2" cy="7.4" rx="2" ry="2.7" />
            <ellipse cx="18.6" cy="10.5" rx="2" ry="2.6" />
          </svg>
        ))}
      </div>
    ))}
  </div>
</div>

<style>
  .paw-track {
    animation: paw-march 26s linear infinite;
  }
</style>
