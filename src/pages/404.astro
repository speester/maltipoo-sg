---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found | Maltipoo.sg"
  description="That page seems to have trotted off. Head back to Singapore's Maltipoo specialists."
  path="/404"
  noindex
>
  <section class="container-site py-24 text-center">
    <p class="eyebrow mb-3">404</p>
    <h1 class="text-3xl md:text-4xl mb-4">This page trotted off somewhere</h1>
    <p class="text-ink-soft mb-8">The puppies are still where you left them.</p>
    <a href="/" class="btn-primary">Back to home</a>
  </section>
</BaseLayout>
