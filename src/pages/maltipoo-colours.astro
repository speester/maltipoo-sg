---
// Core page. Copy authored against briefs/maltipoo-colours.json (2026-07-13).
import BaseLayout from '../layouts/BaseLayout.astro';
import PawTrail from '../components/PawTrail.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import AnswerCapsule from '../components/AnswerCapsule.astro';
import CaptionedBlock from '../components/CaptionedBlock.astro';
import FactsCard from '../components/FactsCard.astro';
import FAQ from '../components/FAQ.astro';
import CtaClose from '../components/CtaClose.astro';
import { whatsappLink } from '../data/site';
import { webPageSchema, breadcrumbSchema, faqSchema } from '../lib/schema';
import featuredImg from '../assets/site/16-maltipoo-colours-group.webp';
import swCreamApricot from '../assets/site/2-maltipoo-card-cream-apricot-f.webp';
import swApricot from '../assets/site/4-maltipoo-card-apricot-teddy.webp';
import swDeepApricot from '../assets/site/8-maltipoo-card-deep-apricot-m.webp';
import swWhite from '../assets/site/43-maltipoo-card-white.webp';
import swCream from '../assets/site/44-maltipoo-card-cream.webp';
import swBlack from '../assets/site/45-maltipoo-card-black.webp';
import swBrown from '../assets/site/46-maltipoo-card-brown.webp';
import swApricotWhite from '../assets/site/10-maltipoo-card-apricot-white.webp';

const title = 'Maltipoo Colours in Singapore: Apricot First | Maltipoo.sg';
const description =
  'Maltipoo colours explained for Singapore buyers: the apricot spectrum we actually place, white, cream and black in the breed.';

const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'Colours', url: '/maltipoo-colours' },
];

const faqItems = [
  {
    q: 'What colour Maltipoo is most expensive?',
    a: 'Deeper and rarer apricot shades sit higher within our $3,288 to $5,988 all-in range, and rare solids command premiums market-wide. Colour and expected adult size are the only two price drivers here; the price guide explains both.',
  },
  {
    q: 'Will a white Maltipoo stay white?',
    a: 'Yes; white is the one shade that does not shift. It is the coloured coats, especially apricot, that lighten as the adult coat arrives. White faces also show tear stains the most, which is a care note rather than a flaw.',
  },
  {
    q: 'Are black Maltipoos rare?',
    a: 'Rarer than apricot, locally very much so. Many black puppies also silver toward a blue-grey as they mature. If black matters to you, look at the parents and ask for photos of previous litters grown up.',
  },
  {
    q: 'Can you predict a puppy’s adult colour?',
    a: 'Within a range, yes: the parents’ adult coats are the best guide, and pigment at the ears and paws hints at where a coat will settle. What no honest seller can promise is an exact shade from an eight-week photo.',
  },
  {
    q: 'Does coat colour affect temperament?',
    a: 'No. An apricot, white or black Maltipoo runs on the same wiring: devoted, clever, and keen on company. Routine shapes the dog; colour shapes the photos.',
  },
];

const schemas = [
  webPageSchema({
    path: '/maltipoo-colours',
    title,
    description,
    aboutName: 'Maltipoo colours',
    datePublished: '2026-07-13',
  }),
  breadcrumbSchema(crumbs),
  faqSchema(faqItems),
];

const swatches = [
  { name: 'Cream apricot', hex: '#f4e3c8', img: swCreamApricot },
  { name: 'Apricot', hex: '#e8b985', img: swApricot },
  { name: 'Deep apricot', hex: '#d19158', img: swDeepApricot },
  { name: 'White', hex: '#faf7f0', img: swWhite },
  { name: 'Cream', hex: '#f1e7d0', img: swCream },
  { name: 'Black', hex: '#2e2b28', img: swBlack },
  { name: 'Brown', hex: '#7a5236', img: swBrown },
  { name: 'Apricot & white', hex: '#f7efe2', img: swApricotWhite },
];
---

<BaseLayout title={title} description={description} path="/maltipoo-colours" schemas={schemas}>
  <section class="container-site pt-4">
    <div class="rounded-[var(--radius-panel)] bg-tint-200 px-6 py-10 md:px-12 relative overflow-hidden rise-in">
        <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
          <svg class="absolute -top-8 -right-8 w-44 h-44 text-white/40" viewBox="0 0 100 100" fill="currentColor"><circle cx="50" cy="50" r="50" /></svg>
          <svg class="absolute top-6 right-[22%] w-9 h-9 text-primary/25 float-soft" style="--float-rot: 14deg" viewBox="0 0 32 32" fill="currentColor"><circle cx="16" cy="19" r="9" /><circle cx="8" cy="11" r="3.4" /><circle cx="16" cy="8.5" r="3.4" /><circle cx="24" cy="11" r="3.4" /></svg>
          <svg class="absolute bottom-5 right-[10%] w-7 h-7 text-primary/20 float-soft" style="--float-rot: -10deg; animation-delay: -2.6s" viewBox="0 0 32 32" fill="currentColor"><circle cx="16" cy="19" r="9" /><circle cx="8" cy="11" r="3.4" /><circle cx="16" cy="8.5" r="3.4" /><circle cx="24" cy="11" r="3.4" /></svg>
          <svg class="absolute -bottom-10 -left-10 w-40 h-40 text-primary/8" viewBox="0 0 100 100" fill="currentColor"><circle cx="50" cy="50" r="50" /></svg>
          <div class="absolute bottom-2 left-0 right-0 opacity-30"><PawTrail /></div>
        </div>
        <div class="relative">
      <Breadcrumb items={crumbs} bare class="mb-5" />
      <p class="eyebrow mb-2">Colours</p>
      <h1 class="text-[clamp(1.9rem,4vw,2.8rem)] mb-3 max-w-[24ch]">Maltipoo colours in Singapore</h1>
      <p class="text-ink-soft max-w-[52ch] mb-5">
        The breed's full palette, the apricot reality of what actually gets placed here, and
        the colour-change truth most listings skip.
      </p>
      <a href={whatsappLink('Hi! Which Maltipoo colours do you currently have available?')} class="btn-cta">Ask about colours</a>
    </div></div>
  </section>

  <AnswerCapsule question="What colours do Maltipoos come in?">
    Maltipoo colors span apricot, cream, white, black, brown and parti combinations. In
    Singapore, the overwhelming majority we place are apricot, from pale cream-apricot to
    deep amber. Puppy coats typically lighten as the adult coat arrives, so the parents
    predict colour better than any puppy photo.
  </AnswerCapsule>

  <section class="container-site pt-8">
    <img
      src={featuredImg.src}
      width={featuredImg.width}
      height={featuredImg.height}
      alt="Three Maltipoos in cream apricot, apricot and deep apricot sitting together"
      loading="lazy"
      class="rounded-[var(--radius-media)] w-full h-auto shadow-[var(--shadow-pop)]"
    />
  </section>

  <section class="container-site py-10" id="palette">
    <h2 class="text-2xl md:text-3xl mb-4">The palette, from our counter</h2>
    <p class="text-ink-soft max-w-[65ch] mb-6">
      Swatches beat adjectives, so here are the maltipoo colours Singapore buyers actually meet. The top row is the apricot maltipoo spectrum that fills our
      gallery most weeks; the bottom row is the rest of the breed's wardrobe, seen here far
      less often.
    </p>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      {swatches.map((sw) => (
        <div class="pop pop-hover p-4 text-center">
          <img src={sw.img.src} width={sw.img.width} height={sw.img.height} alt={`${sw.name} Maltipoo puppy`} loading="lazy" class="rounded-[var(--radius-media)] w-full aspect-square object-cover mb-3" />
          <p class="font-semibold m-0 flex items-center justify-center gap-2">
            <span class="inline-block w-3.5 h-3.5 rounded-full border border-tint-300" style={`background:${sw.hex}`} aria-hidden="true"></span>
            {sw.name}
          </p>
        </div>
      ))}
    </div>
  </section>

  <CaptionedBlock heading="The apricot spectrum we actually place" id="apricot">
    <p>
      Ask what is available in any given month and the answer will usually be three shades of
      the same warm family: cream-apricot, classic apricot, and the deep amber that
      photographs like toffee. Deeper shades sit higher in the
      <a href="/maltipoo-price-singapore">price range</a> because demand outruns supply, not
      because the dog underneath differs.
    </p>
    <p>
      A white maltipoo or a cream maltipoo appears now and then, and a black maltipoo or
      brown maltipoo is a genuine event. If your heart is set on a rarity, tell us early and
      expect an honest wait rather than a promise.
    </p>
    <FactsCard
      slot="side"
      heading="Local colour reality"
      items={[
        'Apricot family: most of what we place',
        'White and cream: occasional',
        'Black and brown: rare here, ask early',
        'Deeper apricot: prices higher, same dog',
      ]}
    />
  </CaptionedBlock>

  <CaptionedBlock heading="Why puppy colour is a moving target" id="clearing" reverse>
    <p>
      Poodle-cross coats carry a fading gene breeders call clearing: a rich apricot puppy
      often matures a shade or two lighter by its first birthday, and some black coats
      silver toward grey. Nothing is wrong
      with the coat; the listing photo was simply a snapshot of a moving process.
    </p>
    <p>
      A note from the shop floor: the only colour complaints we have ever heard trace back to
      sellers who promised a shade from a photo. We show you the parents instead, because
      their adult coats are the finished product the puppy is heading toward.
    </p>
    <FactsCard
      slot="side"
      heading="Colour honesty"
      items={[
        'Coats lighten toward year one (clearing)',
        'Parents show the destination shade',
        'No honest seller promises an exact tone',
        'Photos are snapshots, not guarantees',
      ]}
    />
  </CaptionedBlock>

  <CaptionedBlock heading="Colour and daily care" id="care" tinted>
    <p>
      Colour changes nothing about the dog and one thing about the routine: light faces show
      tear staining most, so the daily eye wipe from the
      <a href="/blog/maltipoo-tear-stains">tear-stain guide</a> matters more for white and
      cream coats. Grooming cadence, costs and the
      <a href="/maltipoo-grooming-haircuts">haircut menu</a> are identical across every
      colour, and so is the temperament.
    </p>
    <FactsCard
      slot="side"
      heading="Care by colour"
      items={[
        'Tear stains: visible most on light faces',
        'Grooming: identical routine, all colours',
        'Temperament: no colour link, at all',
      ]}
    />
  </CaptionedBlock>

  <CaptionedBlock heading="Predicting adult colour, and what colour cannot tell you" id="predicting">
    <p>
      Can adult colour be predicted? Within a shade family, yes; to a paint swatch, no. The reliable signals stack in this order: the parents' adult coats first, the puppy's ear and muzzle tone second (colour holds longest there), and the eight-week body coat a distant third. An apricot puppy with deep-toned ears usually keeps more warmth than its paler littermate.
    </p>
    <p>
      The mechanism is the Poodle-side progressive fading gene: many Maltipoo coats lighten steadily through the first two years, which is why we walk buyers to the parents rather than promise a shade from a photo. Deep apricot that stays deep is the exception worth paying for, not the default.
    </p>
    <p>
      What colour cannot tell you is anything about the dog inside. Temperament tracks the individual and its parents, not the coat; a black Maltipoo is not more aloof, a white one not calmer, whatever the forum thread claims. Choose colour with your eyes and temperament with your <a href="/maltipoo-temperament">temperament homework</a>.
    </p>
    <p>
      Colour does earn one practical vote: lighter faces show tear staining more, so a white or cream buyer should budget the daily thirty-second <a href="/blog/maltipoo-tear-stains">eye wipe</a> from week one. It is cosmetic, it is manageable, and it is the only care line colour actually changes.
    </p>
    <p>
      A note on the rare end of the wardrobe: black and brown Maltipoos usually carry more Poodle in the mix, which can mean a slightly curlier, denser coat and a firmer grooming schedule. Parti coats (apricot and white patches) are pure lottery, the pattern a puppy wears at eight weeks is roughly the pattern it keeps, even as the shades inside it soften.
    </p>
    <p>
      And because we are asked weekly: no, there is no premium worth paying for "rare grey" or "blue" in this cross. Coats that read grey are usually heavy fading in progress, charming, but a phase, not a colour. The honest colour menu in Singapore is the one on this page.
    </p>
    <FactsCard
      slot="side"
      heading="Prediction order"
      items={[
        "1. Parents' adult coats",
        "2. Puppy ear + muzzle tone",
        "3. Eight-week body coat (weakest)",
        "Fading gene lightens coats to year two",
        "Colour never predicts temperament"
      ]}
    />
  </CaptionedBlock>

  <FAQ items={faqItems} />

  <CtaClose
    secondaryHeading="See this month's shades"
    secondaryText="The gallery shows the apricot spectrum currently available or arriving."
    secondaryHref="/puppies"
    secondaryLabel="See available puppies"
  />
</BaseLayout>
